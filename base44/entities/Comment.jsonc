{
  "name": "Comment",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "record",
        "post"
      ],
      "description": "What the comment is attached to"
    },
    "target_id": {
      "type": "string",
      "description": "ID of the target record or post"
    },
    "body": {
      "type": "string",
      "description": "Comment text"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of the commenter"
    },
    "author_id": {
      "type": "string",
      "description": "User id of the commenter"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}